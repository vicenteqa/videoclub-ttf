<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Dark from the very first frame. The app is a wall of posters on a near-black background, and
        a white system window flashing before Compose draws reads as a fault on a television.
    -->
    <style name="Theme.Videoclub" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
